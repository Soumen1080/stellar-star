# ==============================================================================
# Stellar-star Environment Configuration (.env.local.example)
# ==============================================================================
# Copy this file to .env.local to configure your local or staging environment.

# --- Stellar Network Configuration ---
# Options: TESTNET | PUBLIC
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Optional network overrides (derived automatically from NEXT_PUBLIC_STELLAR_NETWORK if omitted)
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_EXPLORER=https://stellar.expert/explorer/testnet

# Smart Contract Addresses (Deployed on Soroban)
NEXT_PUBLIC_CONTRACT_ID=CBS2BJQ4ZC2ZSAZ5XS47BGC6Q7VTMJA4SE2PVHFXGXAZI5ES6H645WHO
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ID=CBS2BJQ4ZC2ZSAZ5XS47BGC6Q7VTMJA4SE2PVHFXGXAZI5ES6H645WHO
# NEXT_PUBLIC_POOL_CONTRACT_ID=
# NEXT_PUBLIC_POOL_TOKEN_ID=

# --- Supabase Database & Auth Configuration ---
# Project URL & Public Anonymous Key (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Service Role Key (NEVER expose to client; used for migrations, restore, and admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase HS256 JWT Secret (Used to sign and verify wallet-based authentication tokens)
# Must match the JWT Secret in Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# --- Receipt Attachments (issue #318) ---
# Receipts are stored in the private "expense-receipts" Supabase Storage bucket
# and require SUPABASE_SERVICE_ROLE_KEY above. Optional tuning:
# RECEIPT_MAX_BYTES=4194304          # per-file limit; keep under your host's request-body cap
# RECEIPT_RETENTION_DAYS=730         # files are purged this long after upload
# Secret for the retention sweep (GET /api/receipts/retention, e.g. from Vercel Cron)
# CRON_SECRET=your-random-cron-secret

# --- Backup & Disaster Recovery ---
# 256-bit passkey used by scripts/backup-supabase.mjs for AES-256-GCM encryption
BACKUP_ENCRYPTION_KEY=your-secure-disaster-recovery-backup-encryption-key

# --- Observability & Alerts ---
# Optional webhook for error reports and on-call alerts (e.g. Slack/Discord/PagerDuty)
# ERROR_REPORTING_WEBHOOK=https://hooks.slack.com/services/...

# --- Reminders & payment requests (#326) ---
# In-app reminders need nothing extra. Email/push are opt-in per member and are
# handed to a relay you operate (any email API or push service) as a JSON POST.
# Leave unset to deliver in-app only.
# REMINDER_EMAIL_WEBHOOK_URL=https://relay.example.com/email
# REMINDER_PUSH_WEBHOOK_URL=https://relay.example.com/push
# REMINDER_WEBHOOK_SECRET=shared-bearer-secret-for-the-relay
# Signs one-click unsubscribe links (falls back to SUPABASE_JWT_SECRET).
# REMINDER_UNSUBSCRIBE_SECRET=long-random-secret

# --- Application Metadata ---
NEXT_PUBLIC_APP_NAME=Stellar-star
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
